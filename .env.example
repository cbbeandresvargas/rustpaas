# ──────────────────────────────────────────────────────
# RustPaaS — Configuración de entorno
# Copia este archivo a `.env` y ajusta los valores.
# ──────────────────────────────────────────────────────

# Directorio raíz donde se almacenan todos los datos del PaaS.
# En Linux/VPS: /var/lib/mypaas
# En Windows (desarrollo): C:\Users\TuUsuario\AppData\Roaming\mypaas
MYPAAS_DATA_DIR=./mypaas-data

# Dirección IP en la que escucha el servidor HTTP
MYPAAS_HOST=0.0.0.0

# Puerto principal del dashboard y la API REST
MYPAAS_PORT=3000

# Puerto del motor S3 embebido
MYPAAS_S3_PORT=9000

# Dominio base para los subdominios de las apps
# Ejemplo: con "mypaas.com", la app "blog" estará en "blog.mypaas.com"
MYPAAS_DOMAIN=localhost

# Rango de puertos que se asignarán automáticamente a las apps
MYPAAS_APP_PORT_START=8100
MYPAAS_APP_PORT_END=8999

# Minutos de inactividad antes de suspender una app (Fase 4)
MYPAAS_SUSPEND_TIMEOUT_MINS=10

# Nivel de log (error, warn, info, debug, trace)
RUST_LOG=mypaas=info,tower_http=warn
